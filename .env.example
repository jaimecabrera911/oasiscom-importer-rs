# Simulación
IS_MOCK=true
MOCK_LATENCY=300ms
MOCK_FAIL=false

# Token
OASIS_TOKEN_URL=https://identity.oasiscom.com/connect/token
OASIS_CONTEXT=
OASIS_USERNAME=
OASIS_PASSWORD=
OASIS_CLIENT_ID=76db5426-2831-4105-9012-209119e53b5e
OASIS_CLIENT_SECRET=511536EF-F270-4058-80CA-1C89C192F69A
OASIS_SCOPE=OasisCo
OASIS_GRANT_TYPE=password

# API externa
OASIS_API_URL=https://app.oasiscom.com/api/externalservices
OASIS_COMPANY_CODE=
OASIS_PUBLICATION_CODE=
OASIS_REQUEST_FORMAT=multipart
OASIS_TOKEN_FIELD=token
OASIS_FILE_FIELD=FileBase64

# Disparador
TRIGGER_WATCH=true
WATCH_DIR=./inbox
WATCH_POLL_INTERVAL=5s
WATCH_PROCESS_EXISTING=false
WATCH_MOVE_AFTER_PROCESS=true
# WATCH_PROCESSED_DIR=./inbox/processed
# WATCH_FAILED_DIR=./inbox/failed
WATCH_STABLE_CHECKS=2

# Estado
STATUS_ENABLED=true
STATUS_FILE=./status/envios.jsonl

# HTTP y logs
HTTP_TIMEOUT=30s
HTTP_RETRIES=2
HTTP_RETRY_BACKOFF=2s
MAX_FILE_BYTES=10485760
LOG_LEVEL=info
